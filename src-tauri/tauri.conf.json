{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkillDeck",
  "version": "0.1.12",
  "identifier": "com.skilldeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkillDeck",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGNDBCQ0ZDOTA3RTdBQ0UKUldUT2VuNlEvTHhBMzdjdG1kZHJYZldtUG5VSnpxM1VCS3c5NDBpSWtSS3pRZ2ZXbG1tQjR6aUwK",
      "endpoints": [
        "https://github.com/yidasanqian/skilldeck/releases/latest/download/latest.json"
      ]
    }
  }
}
